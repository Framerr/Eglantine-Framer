<component type="desktop-application">
  <id>io.github.framerr.frameropia</id>
  <metadata_license>CC0-1.0</metadata_license>
  <name>Frameropia</name>
  <summary>Experimental Nintendo Switch 2 emulator</summary>
  <description>
    <p>Frameropia is an experimental open-source Nintendo Switch 2 emulator fork focused on Pokémon Pokopia compatibility. Based on Eglantine and Eden.</p>
  </description>
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <keywords>
    <keyword>switch</keyword>
    <keyword>emulator</keyword>
  </keywords>
  <url type="homepage">https://github.com/Framerr/Frameropia</url>
  <url type="bugtracker">https://github.com/Framerr/Frameropia/issues</url>
  <url type="faq">https://github.com/Framerr/Frameropia#downloads-and-testing</url>
  <url type="help">https://github.com/Framerr/Frameropia/blob/nx2/docs/user/README.md</url>
  <url type="vcs-browser">https://github.com/Framerr/Frameropia</url>
  <url type="contribute">https://github.com/Framerr/Frameropia</url>
  <launchable type="desktop-id">io.github.framerr.frameropia.desktop</launchable>
  <provides>
    <binary>frameropia</binary>
    <binary>frameropia-cli</binary>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>gamepad</control>
    <internet>offline-only</internet>
  </supports>
  <requires>
    <memory>8192</memory>
  </requires>
  <recommends>
    <memory>16384</memory>
  </recommends>
  <project_license>GPL-3.0-or-later</project_license>
  <developer_name>Frameropia contributors</developer_name>
  <content_rating type="oars-1.0"/>
</component>
